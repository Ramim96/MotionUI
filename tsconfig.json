{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      // Components
      "@components/*": ["./design-system/*"],
      "@accordions/*": ["./design-system/accordions/*"],
      "@buttons/*": ["./design-system/buttons/*"],
      "@icons/*": ["./design-system/icons/*"],
      "@layouts/*": ["./design-system/layout/*"],
      "@forms/*": ["./components/forms/*"],
      "@input-fields/*": ["./components/input-fields/*"],
      "@texts/*": ["./design-system/texts/*"],
      // Sandbox
      "@sandbox/*": ["./sandbox/*"],
      // Context
      "@contexts/*": ["./contexts/*"],
      // Hook
      "@hooks/*": ["./hooks/*"],
      // Routes
      "@routes/*": ["./routes/*"],
      // Shared
      "@shared/*": ["./shared/*"],
      // Styles
      "@styles/*": ["./styles/*"],
      // Utils
      "@utils/*": ["./utils/*"],
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}